{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dundercode.dev/desys/schemas/compatibility-1.1.0.json",
  "title": "DESys Distribution Compatibility Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "compatibility_schema",
    "package_name",
    "profiles"
  ],
  "properties": {
    "compatibility_schema": {
      "const": "1.1.0"
    },
    "package_name": {
      "const": "dundercode-engineering-system"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "$defs": {
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_version",
        "release_tag",
        "source_commit",
        "corpus_version",
        "inventory_schema",
        "bundle_schema",
        "consumer_manifest_schema",
        "metadata_schema",
        "bundle_checksum",
        "reference_bundle_schema_checksum",
        "consumer_manifest_schema_checksum",
        "compatibility_schema_checksum",
        "predecessor_descriptor_schema_checksum",
        "requires_python",
        "platforms",
        "direct_predecessors"
      ],
      "properties": {
        "package_version": {
          "type": "string",
          "minLength": 1
        },
        "release_tag": {
          "type": "string",
          "minLength": 1
        },
        "source_commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "corpus_version": {
          "$ref": "#/$defs/version"
        },
        "inventory_schema": {
          "$ref": "#/$defs/version"
        },
        "bundle_schema": {
          "$ref": "#/$defs/version"
        },
        "consumer_manifest_schema": {
          "$ref": "#/$defs/version"
        },
        "metadata_schema": {
          "$ref": "#/$defs/version"
        },
        "bundle_checksum": {
          "$ref": "#/$defs/checksum"
        },
        "reference_bundle_schema_checksum": {
          "$ref": "#/$defs/checksum"
        },
        "consumer_manifest_schema_checksum": {
          "$ref": "#/$defs/checksum"
        },
        "compatibility_schema_checksum": {
          "$ref": "#/$defs/checksum"
        },
        "predecessor_descriptor_schema_checksum": {
          "$ref": "#/$defs/checksum"
        },
        "requires_python": {
          "type": "string",
          "minLength": 1
        },
        "platforms": {
          "type": "array",
          "items": {
            "enum": [
              "linux",
              "macos",
              "windows"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "direct_predecessors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bundle_checksum",
              "descriptor_checksum"
            ],
            "properties": {
              "bundle_checksum": {
                "$ref": "#/$defs/checksum"
              },
              "descriptor_checksum": {
                "$ref": "#/$defs/checksum"
              }
            }
          },
          "uniqueItems": true
        }
      }
    }
  }
}
