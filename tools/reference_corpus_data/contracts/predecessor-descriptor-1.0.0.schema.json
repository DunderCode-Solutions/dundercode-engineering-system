{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dundercode.dev/desys/schemas/predecessor-descriptor-1.0.0.json",
  "title": "DESys Trusted Predecessor Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "predecessor_descriptor_schema",
    "target_bundle_checksum",
    "accepted_manifest_schemas",
    "predecessor_package_version",
    "bundle_schema",
    "inventory_schema",
    "corpus_version",
    "release_tag",
    "source_commit",
    "entries",
    "bundle_checksum"
  ],
  "properties": {
    "predecessor_descriptor_schema": {
      "const": "1.0.0"
    },
    "target_bundle_checksum": {
      "$ref": "#/$defs/checksum"
    },
    "accepted_manifest_schemas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/version"
      }
    },
    "predecessor_package_version": {
      "type": "string",
      "minLength": 1
    },
    "bundle_schema": {
      "$ref": "#/$defs/version"
    },
    "inventory_schema": {
      "$ref": "#/$defs/version"
    },
    "corpus_version": {
      "$ref": "#/$defs/version"
    },
    "release_tag": {
      "$ref": "#/$defs/releaseTag"
    },
    "source_commit": {
      "$ref": "#/$defs/sourceCommit"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "bundle_checksum": {
      "$ref": "#/$defs/checksum"
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "releaseTag": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(alpha|beta|rc)\\.[0-9]+)?$"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target",
        "collection",
        "classification",
        "indexable",
        "checksum"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\).+$"
        },
        "target": {
          "type": "string",
          "pattern": "^docs/desys/(?:LICENSE|THIRD_PARTY_NOTICES\\.md|reference/(?:foundation|knowledge|engineering|delivery|skills)/.+)$"
        },
        "collection": {
          "enum": [
            "foundation",
            "knowledge",
            "engineering",
            "delivery",
            "skills",
            "legal"
          ]
        },
        "classification": {
          "enum": [
            "document",
            "navigation",
            "placeholder",
            "legal",
            "schema",
            "supplemental"
          ]
        },
        "indexable": {
          "type": "boolean"
        },
        "checksum": {
          "$ref": "#/$defs/checksum"
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "canonical_id": {
          "type": "string",
          "minLength": 1
        },
        "metadata_status": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
