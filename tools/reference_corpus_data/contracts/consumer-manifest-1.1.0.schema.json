{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dundercode.dev/desys/schemas/consumer-manifest-1.1.0.json",
  "title": "DESys Consumer Corpus Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema",
    "package_name",
    "package_version",
    "package_source",
    "release_tag",
    "source_commit",
    "corpus_version",
    "bundle_checksum",
    "entries"
  ],
  "properties": {
    "manifest_schema": {
      "const": "1.1.0"
    },
    "package_name": {
      "const": "dundercode-engineering-system"
    },
    "package_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:(?:a|b|rc)[0-9]+)?(?:\\.post[0-9]+)?(?:\\.dev[0-9]+)?(?:\\+[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
    },
    "package_source": {
      "type": "string",
      "minLength": 1
    },
    "release_tag": {
      "$ref": "#/$defs/releaseTag"
    },
    "source_commit": {
      "$ref": "#/$defs/sourceCommit"
    },
    "corpus_version": {
      "$ref": "#/$defs/semanticVersion"
    },
    "bundle_checksum": {
      "$ref": "#/$defs/checksum"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "releaseTag": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(alpha|beta|rc)\\.[0-9]+)?$"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target",
        "collection",
        "classification",
        "distribution",
        "original_checksum",
        "installed_checksum"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\).+$"
        },
        "target": {
          "type": "string",
          "pattern": "^docs/desys/(?:LICENSE|THIRD_PARTY_NOTICES\\.md|reference/(?:foundation|knowledge|engineering|delivery|skills)/.+)$"
        },
        "collection": {
          "enum": [
            "foundation",
            "knowledge",
            "engineering",
            "delivery",
            "skills",
            "legal"
          ]
        },
        "classification": {
          "enum": [
            "document",
            "navigation",
            "placeholder",
            "legal",
            "schema",
            "supplemental"
          ]
        },
        "distribution": {
          "const": "approved"
        },
        "original_checksum": {
          "$ref": "#/$defs/checksum"
        },
        "installed_checksum": {
          "$ref": "#/$defs/checksum"
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "canonical_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
